{% set gdprs = craft.entries().section('pages').addGdpr(true).all() %}
{% set contact = craft.entries.section('contact').one() %}

<div class="requiredInfo margin">
    <div class="requiredInfo__credentials">
        <p class="requiredInfo__item">© Despierre</p>
        <p class="requiredInfo__item">BTW BE{{ contact.f_btw}}</p>
        {% for item in gdprs %}
            <a class="requiredInfo__item requiredInfo__link" href="{{ item.url }}">{{ item.altTitle is not null ? item.altTitle : item.title }}</a>
        {% endfor %}
    </div>
    <div class="requiredInfo__madeBy">
        <a class="requiredInfo__link" href="https://www.likeavirgin.be/nl" aria-label="Bezoek de site van de maker van deze site">                 
            {{ svg("assets/icons/g.svg")|attr({class: 'requiredInfo__g' }) }} 
            Like a Virgin
        </a>
    </div>
</div>
